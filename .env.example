# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
EVENT_NAME=My Event 2026
ADMIN_KEY=change-this-to-something-long

# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=your.address@gmail.com

# Online database (Neon, Supabase, Render, ...). If set, it replaces the local SQLite file.
# Neon: create a project, copy the connection string (must include sslmode=require).
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Alternative to SMTP (no password): Google Apps Script web app, see apps_script/Code.gs.
# If MAIL_WEBHOOK_URL is set it is used instead of SMTP. Secret must match SECRET in the script.
# MAIL_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# MAIL_WEBHOOK_SECRET=long-random-string

# Static front-end on GitHub Pages: origins allowed to call this API (comma separated, no trailing slash)
# ALLOWED_ORIGINS=https://yourname.github.io

# Email checks: set to 0 to skip the DNS "can this domain receive mail" test
# CHECK_EMAIL_DNS=1

# Optional lines in the ticket email
# EVENT_DATE=Saturday, December 5, 2026, 9:00 AM
# EVENT_VENUE=Main Hall, Manila
# CONTACT_EMAIL=events@example.com

# Rate limits per client IP, "max requests/seconds"
# RATE_API=120/60                # all API calls
# RATE_REGISTER=10/600           # form submissions
# RATE_REGISTER_GLOBAL=120/3600  # form submissions from everyone together (protects the email quota)
# RATE_AUTHFAIL=10/600           # wrong admin keys before a lock-out
# TRUST_PROXY=0                  # 1 = read the client IP from X-Forwarded-For (only for servers that don't do it themselves)

# Optional
# PORT=5000
# HTTPS=1          # self-signed HTTPS for phone camera testing on your LAN
# DB_PATH=/data/event.db
