# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
EVENT_NAME=My Event 2026
ADMIN_KEY=change-this-to-something-long

# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=your.address@gmail.com

# Optional
# PORT=5000
# HTTPS=1          # self-signed HTTPS for phone camera testing on your LAN
# DB_PATH=/data/event.db
